# Copia a .env y ajusta. Los secretos viven SOLO en el ambiente/despliegue,
# nunca en el repositorio (reglas del proyecto).

# --- App ---
APP_NAME=CSC - Sistema de Gestión de Licitaciones
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Base de datos (PostgreSQL en Docker) ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/licitaciones_db

# --- Seguridad ---
# En producción: secretos fuertes generados con `openssl rand -hex 32`
# (mínimo 32 bytes para HS256, RFC 7518).
SECRET_KEY=change-me-genera-uno-de-32-bytes-al-menos
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CRON_SECRET=change-me

# --- Seed admin inicial (scripts/seed_admin.py) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CambiaEstaClave1!
ADMIN_NAME=Administrador

# --- Integraciones (opcionales en desarrollo) ---
# Resend: key del dashboard (https://resend.com/api-keys). En desarrollo el
# dominio sandbox (onboarding@resend.dev) solo envía al email verificado de
# la cuenta: pon ese email en RESEND_TEST_TO para las verificaciones.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
RESEND_TEST_TO=
# Supabase Storage (bucket privado + URL firmada). Acepta las keys nuevas
# `sb_secret_...` (2025) y las clásicas (`eyJ...`); se usan vía REST.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=